{
  "extends": ["@vue/tsconfig/tsconfig.dom.json", "./tsconfig.json"],
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["vite/client"]
  },
  "include": [
    "src/renderer/src/**/*.ts",
    "src/renderer/src/**/*.vue",
    "src/shared/**/*.ts"
  ]
}

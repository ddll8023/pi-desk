{
  "name": "pi-desk",
  "version": "0.1.0",
  "private": true,
  "description": "Pi Desktop 最小桌面骨架",
  "type": "module",
  "main": "out/main/index.cjs",
  "packageManager": "npm@11.16.0",
  "scripts": {
    "dev": "npm run auth-helper:build && electron-vite dev",
    "build": "npm run auth-helper:build && electron-vite build",
    "start": "electron-vite preview",
    "auth-helper:build": "vite build --config vite.auth-helper.config.ts",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "pi:prepare": "node scripts/prepare-pi-runtime.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.0.4",
    "dompurify": "3.4.16",
    "marked": "18.0.11",
    "pinia": "4.0.3",
    "vue": "3.5.43"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.1",
    "@vitejs/plugin-vue": "6.0.9",
    "@vue/tsconfig": "0.9.1",
    "electron": "44.7.0",
    "electron-vite": "5.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vue-tsc": "3.3.12"
  }
}

{
  "name": "pi-desk",
  "version": "0.1.0",
  "private": true,
  "description": "Pi Desktop 最小桌面骨架",
  "author": "dongzhouhan <1728964316@qq.com>",
  "type": "module",
  "main": "out/main/index.cjs",
  "packageManager": "npm@11.16.0",
  "scripts": {
    "dev": "npm run fix:pty-permissions && npm run auth-helper:build && npm run sdk-host:build && electron-vite dev",
    "build": "npm run auth-helper:build && npm run sdk-host:build && electron-vite build",
    "start": "npm run fix:pty-permissions && electron-vite preview",
    "fix:pty-permissions": "node scripts/fix-node-pty-permissions.mjs",
    "auth-helper:build": "vite build --config vite.auth-helper.config.ts",
    "sdk-host:build": "vite build --config vite.sdk-host.config.ts",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "node --test src/main/*.test.ts src/renderer/src/*.test.ts",
    "package:portable": "npm run build && node scripts/package-portable.mjs",
    "package:win": "npm run build && node scripts/package-portable.mjs --win",
    "package:mac": "npm run build && node scripts/package-portable.mjs --mac"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/language-data": "6.5.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@earendil-works/pi-coding-agent": "1.2.0",
    "@lezer/highlight": "1.2.5",
    "@vueuse/core": "15.0.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror": "6.0.2",
    "cross-spawn": "7.0.6",
    "dompurify": "3.4.16",
    "katex": "0.19.0",
    "marked": "18.0.11",
    "motion-v": "2.6.0",
    "node-pty": "1.1.0",
    "pinia": "4.0.3",
    "vue": "3.5.43"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "24.19.1",
    "@vitejs/plugin-vue": "6.0.9",
    "@vue/tsconfig": "0.9.1",
    "electron": "44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "5.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vue-tsc": "3.3.12"
  }
}
